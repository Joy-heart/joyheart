# JoyHeart public Supabase project configuration.
# These values are safe for browser use when Row Level Security is enabled
# and all exposed tables/storage policies are correctly restricted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put a Supabase service-role key or database password in this file.
# Private credentials belong in Cloudflare secrets, not browser variables.
