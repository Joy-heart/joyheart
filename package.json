{
  "name": "joyheart",
  "version": "0.1.0",
  "private": true,
  "description": "JoyHeart — an international dating and matchmaking platform focused on genuine connections, trust, safety, and meaningful relationships.",
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
